# Copy this file to .env (in backend/) and fill in the blanks. Don't commit .env.

# The address you open GradeFlow at. UMD's CAS sends people back to <this>/api/auth/callback.
# UMD refuses to validate tickets for localhost or 127.0.0.1, so locally we use gradeflow.test,
# another name for your own machine (add "127.0.0.1 gradeflow.test" to /etc/hosts; see README).
APP_BASE_URL=http://gradeflow.test:3000

# UMD's CAS server.
CAS_SERVER_URL=https://shib.idm.umd.edu/shibboleth-idp/profile/cas

# Signs the session cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# PostgreSQL. Matches docker-compose.yml (we start it from the repo root with docker compose up -d db).
DATABASE_URL=postgresql://gradeflow:gradeflow@127.0.0.1:5432/gradeflow

# Sessions end after this many hours with no activity...
SESSION_IDLE_HOURS=12

# ...and always this many days after sign-in.
SESSION_MAX_DAYS=7
